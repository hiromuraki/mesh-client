+// 身份由 --secure-mode / ET_CREDENTIAL 决定，但 core 在**装载配置的那一刻**就按
+// 「TOML 里 secure_mode 是否开着」定型网络身份（TomlConfigLoader::new_from_config）：
+// 装载完再调 set_secure_mode 只换得来密钥、换不来身份，凭据节点会退化成「正式节点 +
+// 空 secret」，握手时被种子以 authentication failed: invalid proof and unknown
+// credential 拒掉。所以这里把 secure_mode 写进配置文本再交给 loader，身份定型与密钥
+// 规范化都让 core 自己做。
+fn secure_mode_for(config: &impl ConfigLoader, options: &RunOptions) -> Option<SecureModeConfig> {
+    if let Some(secret) = options.credential.as_deref() {
+        return Some(SecureModeConfig {
+            enabled: true,
+            local_private_key: Some(secret.to_owned()),
+            local_public_key: None,
+        });
+    }
+    if !options.secure_mode {
+        return None;
+    }
+    let from_env = options.local_private_key.clone().filter(|key| !key.is_empty());
+    let from_file = config.get_secure_mode();
+    let local_public_key = if from_env.is_some() {
+        None
+    } else {
+        from_file
+            .as_ref()
+            .and_then(|mode| mode.local_public_key.clone())
+    };
+    let local_private_key = from_env.or_else(|| {
+        from_file
+            .as_ref()
+            .and_then(|mode| mode.local_private_key.clone())
+    });
+    Some(SecureModeConfig {
+        enabled: true,
+        local_private_key,
+        local_public_key,
+    })
+}
+
+fn with_secure_mode(text: &str, mode: &SecureModeConfig) -> String {
+    let mut out = drop_secure_mode_table(text);
+    out.push_str("\n[secure_mode]\nenabled = true\n");
+    if let Some(key) = mode.local_private_key.as_ref() {
+        out.push_str(&format!("local_private_key = \"{}\"\n", toml_string(key)));
+    }
+    if let Some(key) = mode.local_public_key.as_ref() {
+        out.push_str(&format!("local_public_key = \"{}\"\n", toml_string(key)));
+    }
+    out
+}
+
+// 配置里原本的 [secure_mode] 整段丢掉：身份入口只有命令行与环境变量，配置文件里那份
+// 只可能是过期的副本。
+fn drop_secure_mode_table(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut dropping = false;
+    for line in text.lines() {
+        let trimmed = line.trim_start();
+        if trimmed.starts_with('[') {
+            dropping = trimmed.starts_with("[secure_mode]");
+        }
+        if dropping {
+            continue;
+        }
+        out.push_str(line);
+        out.push('\n');
+    }
+    out
+}
+
+fn toml_string(value: &str) -> String {
+    value.replace('\\', "\\\\").replace('"', "\\\"")
+}
+
+fn load_local_config(
+    config_path: &PathBuf,
+    options: &RunOptions,
+) -> anyhow::Result<TomlConfigLoader> {
+    let source = config_path.display().to_string();
+    let text = std::fs::read_to_string(config_path)
+        .with_context(|| format!("failed to read config file: {source}"))?;
+    let mut config = load_toml_config_from_str_with_source(&source, &text)?;
+    if let Some(mode) = secure_mode_for(&config, options) {
+        config = load_toml_config_from_str_with_source(&source, &with_secure_mode(&text, &mode))?;
+    }
+    if let Some(hostname) = options.hostname.clone().filter(|name| !name.is_empty()) {
+        config.set_hostname(Some(hostname));
+    }
+    Ok(config)
+}
